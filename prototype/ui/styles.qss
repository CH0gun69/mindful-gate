QWidget {
    background-color: #14161a;
    color: #eef0f2;
    font-family: "Segoe UI", "SF Pro Text", sans-serif;
}
QLabel#screenTitle {
    font-size: 24px;
    font-weight: 600;
}
QLabel#bigScreenTime {
    font-size: 44px;
    font-weight: 700;
    color: #8fd3c7;
}
QLabel#caption {
    color: #9aa1ab;
    font-size: 13px;
}
QLabel#sectionLabel {
    font-size: 14px;
    font-weight: 600;
    color: #c9cdd3;
    margin-top: 8px;
}
QFrame#statCard {
    background-color: #1d2026;
    border-radius: 10px;
    padding: 12px;
}
QFrame#screenTimeCard {
    background-color: #1d2026;
    border-radius: 14px;
    padding: 18px;
}
QLabel#statValue {
    background: transparent;
    font-size: 20px;
    font-weight: 700;
}
QLabel#statLabel {
    background: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QFrame#appRow {
    background-color: #1d2026;
    border-radius: 8px;
    padding: 8px;
}
QLabel#appName {
    background: transparent;
    font-weight: 500;
}
QLabel#badge {
    background: transparent;
    color: #8fd3c7;
    font-size: 11px;
    margin-left: 8px;
}
QLabel#appTime {
    background: transparent;
    color: #9aa1ab;
}
QPushButton#primaryBtn {
    background-color: #8fd3c7;
    color: #0e1012;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#primaryBtn:hover {
    background-color: #a3ded3;
}
QPushButton#secondaryBtn {
    background-color: transparent;
    color: #eef0f2;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
}
QPushButton#linkBtn, QPushButton#simulateBtn {
    background-color: transparent;
    color: #9aa1ab;
    border: none;
    padding: 8px;
    font-size: 13px;
    text-decoration: underline;
}
QLabel#interruptTitle {
    font-size: 18px;
    color: #9aa1ab;
}
QLabel#interruptQuestion {
    font-size: 30px;
    font-weight: 700;
}
QLabel#interruptIcon {
    font-size: 64px;
    background: transparent;
}
QLabel#intentionQuote {
    font-size: 16px;
    font-style: italic;
    color: #8fd3c7;
    padding: 16px;
    background-color: #1d2026;
    border-radius: 10px;
}
QCheckBox {
    font-size: 14px;
    padding: 4px;
}
QLineEdit#intentionInput {
    background-color: #1d2026;
    border: 1px solid #3a3f47;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
}

/* ===== Phone Home Screen ===== */
QWidget#phoneHomeScreen {
    background-color: #14161a;
}
QFrame#phoneStatusBar {
    background-color: #14161a;
    border-bottom: 1px solid #22262c;
}
QLabel#statusBarTime {
    background-color: transparent;
    color: #eef0f2;
    font-size: 15px;
    font-weight: 600;
}
QLabel#statusBarIcons {
    background-color: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QWidget#phoneHomeGrid {
    background-color: transparent;
}
QPushButton#appIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#appIcon:pressed {
    background-color: rgba(143, 211, 199, 0.15);
    border-radius: 12px;
}
QLabel#appIconLabel {
    background-color: transparent;
    color: #c9cdd3;
    font-size: 11px;
}
QWidget#phoneHomeScreenTimeWrap {
    background-color: transparent;
}
QPushButton#screenTimeWidget {
    background-color: #1d2026;
    border: none;
    border-radius: 14px;
    text-align: left;
}
QPushButton#screenTimeWidget:pressed {
    background-color: #23272f;
}
QLabel#screenTimeValue {
    background: transparent;
    color: #8fd3c7;
    font-size: 22px;
    font-weight: 700;
}
QLabel#screenTimeCaption {
    background: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QFrame#screenTimeDivider {
    background-color: #3a3f47;
}
QLabel#screenTimeUnlocksValue {
    background: transparent;
    color: #eef0f2;
    font-size: 18px;
    font-weight: 700;
}
QLabel#screenTimeUnlocksCaption {
    background: transparent;
    color: #9aa1ab;
    font-size: 11px;
}
QFrame#phoneDock {
    background-color: #1d2026;
    border-radius: 20px;
}
QPushButton#dockIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#dockIcon QLabel#appIconLabel {
    color: #9aa1ab;
    font-size: 10px;
}

/* ===== Fake App Screen ===== */
QWidget#fakeAppScreen {
    background-color: #14161a;
}
QFrame#fakeAppHeader {
    background-color: #14161a;
    border-bottom: 1px solid #22262c;
}
QPushButton#fakeAppBackBtn {
    background-color: transparent;
    border: none;
    color: #eef0f2;
    font-size: 18px;
    padding: 4px 8px;
}
QPushButton#fakeAppBackBtn:pressed {
    color: #8fd3c7;
}
QLabel#fakeAppTitle {
    background-color: transparent;
    color: #eef0f2;
    font-size: 17px;
    font-weight: 600;
}
QLabel#fakeAppNote {
    background-color: transparent;
    color: #9aa1ab;
    font-size: 12px;
    font-style: italic;
}
QFrame#fakeAppCard {
    background-color: #1d2026;
    border-radius: 10px;
    padding: 18px;
}
QFrame#fakeAppCard QLabel {
    background-color: transparent;
    color: #c9cdd3;
    font-size: 13px;
}
