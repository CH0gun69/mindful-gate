QWidget {
    background-color: #14161a;
    color: #eef0f2;
    font-family: "Segoe UI", "SF Pro Text", sans-serif;
}
QLabel#screenTitle {
    font-size: 24px;
    font-weight: 600;
}
QLabel#bigScreenTime {
    font-size: 44px;
    font-weight: 700;
    color: #8fd3c7;
}
QLabel#caption {
    color: #9aa1ab;
    font-size: 13px;
}
QLabel#sectionLabel {
    font-size: 14px;
    font-weight: 600;
    color: #c9cdd3;
    margin-top: 8px;
}
QFrame#statCard {
    background-color: #1d2026;
    border-radius: 10px;
    padding: 12px;
}
QFrame#screenTimeCard {
    background-color: #1d2026;
    border-radius: 14px;
    padding: 18px;
}
QLabel#statValue {
    background: transparent;
    font-size: 20px;
    font-weight: 700;
}
QLabel#statLabel {
    background: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QFrame#appRow {
    background-color: #1d2026;
    border-radius: 8px;
    padding: 8px;
}
QLabel#appName {
    background: transparent;
    font-weight: 500;
}
QLabel#badge {
    background: transparent;
    color: #8fd3c7;
    font-size: 11px;
    margin-left: 8px;
}
QLabel#appTime {
    background: transparent;
    color: #9aa1ab;
}
QPushButton#primaryBtn {
    background-color: #8fd3c7;
    color: #0e1012;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#primaryBtn:hover {
    background-color: #a3ded3;
}
QPushButton#secondaryBtn {
    background-color: transparent;
    color: #eef0f2;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
}
QPushButton#linkBtn, QPushButton#simulateBtn {
    background-color: transparent;
    color: #9aa1ab;
    border: none;
    padding: 8px;
    font-size: 13px;
    text-decoration: underline;
}
QLabel#interruptTitle {
    font-size: 18px;
    color: #9aa1ab;
}
QLabel#interruptQuestion {
    font-size: 30px;
    font-weight: 700;
}
QLabel#interruptIcon {
    font-size: 64px;
    background: transparent;
}
QLabel#intentionQuote {
    font-size: 16px;
    font-style: italic;
    color: #8fd3c7;
    padding: 16px;
    background-color: #1d2026;
    border-radius: 10px;
}
QCheckBox {
    font-size: 14px;
    padding: 4px;
}
QLineEdit#intentionInput {
    background-color: #1d2026;
    border: 1px solid #3a3f47;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
}

/* ===== Phone Home Screen ===== */
QWidget#phoneHomeScreen {
    background-color: #14161a;
}
QFrame#phoneStatusBar {
    background-color: #14161a;
    border-bottom: 1px solid #22262c;
}
QLabel#statusBarTime {
    background-color: transparent;
    color: #eef0f2;
    font-size: 15px;
    font-weight: 600;
}
QLabel#statusBarIcons {
    background-color: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QWidget#phoneHomeGrid {
    background-color: transparent;
}
QPushButton#appIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#appIcon:pressed {
    background-color: rgba(143, 211, 199, 0.15);
    border-radius: 12px;
}
QLabel#appIconLabel {
    background-color: transparent;
    color: #c9cdd3;
    font-size: 11px;
}
QWidget#phoneHomeScreenTimeWrap {
    background-color: transparent;
}
QPushButton#screenTimeWidget {
    background-color: #1d2026;
    border: none;
    border-radius: 14px;
    text-align: left;
}
QPushButton#screenTimeWidget:pressed {
    background-color: #23272f;
}
QLabel#screenTimeValue {
    background: transparent;
    color: #8fd3c7;
    font-size: 22px;
    font-weight: 700;
}
QLabel#screenTimeCaption {
    background: transparent;
    color: #9aa1ab;
    font-size: 12px;
}
QFrame#screenTimeDivider {
    background-color: #3a3f47;
}
QLabel#screenTimeUnlocksValue {
    background: transparent;
    color: #eef0f2;
    font-size: 18px;
    font-weight: 700;
}
QLabel#screenTimeUnlocksCaption {
    background: transparent;
    color: #9aa1ab;
    font-size: 11px;
}
QFrame#phoneDock {
    background-color: #1d2026;
    border-radius: 20px;
}
QPushButton#dockIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#dockIcon QLabel#appIconLabel {
    color: #9aa1ab;
    font-size: 10px;
}

/* ===== Fake App Screen ===== */
QWidget#fakeAppScreen {
    background-color: #14161a;
}
QFrame#fakeAppHeader {
    background-color: #14161a;
    border-bottom: 1px solid #22262c;
}
QPushButton#fakeAppBackBtn {
    background-color: transparent;
    border: none;
    color: #eef0f2;
    font-size: 18px;
    padding: 4px 8px;
}
QPushButton#fakeAppBackBtn:pressed {
    color: #8fd3c7;
}
QLabel#fakeAppTitle {
    background-color: transparent;
    color: #eef0f2;
    font-size: 17px;
    font-weight: 600;
}
/* --- feed style: Instagram / Facebook / X (Twitter) / Reddit ---
   Leans neutral/realistic rather than mindful-gate's own teal-accent
   design system on purpose -- this is meant to read as "a real app",
   not as part of this app's own UI. */
QFrame#feedPostCard {
    background-color: #1c1c1e;
    border-radius: 10px;
}
QLabel#feedUsername {
    background-color: transparent;
    color: #f2f2f2;
    font-weight: 600;
    font-size: 13px;
}
QLabel#feedPhoto {
    background-color: #0d0d0d;
    border-radius: 0px;
}
QLabel#feedCaption {
    background-color: transparent;
    color: #cfcfcf;
    font-size: 12px;
}

/* Instagram/X action row: icon-only, evenly spaced */
QFrame#feedActionsIcons {
    background-color: transparent;
}
QPushButton#feedActionIcon {
    background-color: transparent;
    border: none;
    color: #e8e8e8;
    font-size: 20px;
    /* Fixed square (not padding-around-content) so the click-flash
       background forms a consistent circle regardless of how wide each
       glyph happens to render -- auto-sizing to content made the
       highlight crop unevenly around some icons (looked uncanny,
       confirmed via manual testing). */
    min-width: 34px; max-width: 34px;
    min-height: 34px; max-height: 34px;
    border-radius: 17px;
}
QPushButton#feedActionIconSmall {
    background-color: transparent;
    border: none;
    color: #a8a8a8;
    font-size: 15px;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    border-radius: 14px;
}

/* Facebook action row: full-width labeled buttons + thin dividers */
QFrame#feedActionsLabeled {
    background-color: transparent;
    border-top: 1px solid #2a2a2c;
}
QPushButton#feedActionLabeled {
    background-color: transparent;
    border: none;
    color: #b8b8b8;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 0px;
    border-radius: 8px;
}
QFrame#feedActionDivider {
    background-color: #2a2a2c;
    margin: 6px 0px;
}

/* Reddit vote cluster: vertical, left side of the card */
QFrame#voteCluster {
    background-color: #161617;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}
QPushButton#voteArrowUp, QPushButton#voteArrowDown {
    background-color: transparent;
    border: none;
    color: #818384;
    font-size: 13px;
    padding: 2px;
}
QLabel#voteCount {
    background-color: transparent;
    color: #d7dadc;
    font-size: 11px;
    font-weight: 700;
}
QLabel#feedCommentCount {
    background-color: transparent;
    color: #818384;
    font-size: 11px;
}

/* Scrollable feed/messages content -- QWidget's own global rule already
   covers the dark background; this just removes the frame border and
   gives the vertical scrollbar a slim, dark-theme-appropriate look
   instead of Qt's default light one. */
QScrollArea#feedScrollArea, QScrollArea#messagesChatScrollArea {
    border: none;
}
QScrollArea#feedScrollArea QScrollBar:vertical,
QScrollArea#messagesChatScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}
QScrollArea#feedScrollArea QScrollBar::handle:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::handle:vertical {
    background: #3a3f47;
    border-radius: 3px;
    min-height: 24px;
}
QScrollArea#feedScrollArea QScrollBar::add-line:vertical,
QScrollArea#feedScrollArea QScrollBar::sub-line:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::add-line:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- shorts style: TikTok / YouTube --- */
QFrame#shortsWrap {
    background-color: #000000;
}
QLabel#shortsImage {
    background-color: #000000;
}
QFrame#shortsCaptionBar {
    background-color: rgba(0, 0, 0, 0.55);
}
QLabel#shortsUsername {
    background-color: transparent;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
}
QLabel#shortsCaption {
    background-color: transparent;
    color: #e8e8e8;
    font-size: 12px;
}
QFrame#shortsIconsCol {
    background-color: transparent;
}
QLabel#shortsEngageIcon {
    background-color: transparent;
    color: #ffffff;
    font-size: 22px;
}
QLabel#shortsEngageCount {
    background-color: transparent;
    color: #d8d8d8;
    font-size: 10px;
    font-weight: 600;
}

/* --- messages style --- */
QFrame#messagesSidebar {
    background-color: #17181a;
    border-right: 1px solid #26282c;
}
QWidget#messagesChatView {
    background-color: #14161a;
}
QFrame#messagesContactRow {
    background-color: transparent;
    border-radius: 8px;
}
QFrame#messagesContactRowActive {
    background-color: #23272f;
    border-radius: 8px;
}
QLabel#messagesContactName {
    background-color: transparent;
    color: #eef0f2;
    font-size: 12px;
    font-weight: 600;
}
QLabel#messagesContactPreview {
    background-color: transparent;
    color: #8a8f98;
    font-size: 11px;
}
QLabel#chatBubbleMe {
    background-color: #8fd3c7;
    color: #0e1012;
    border-radius: 14px;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#chatBubbleThem {
    background-color: #2a2d33;
    color: #eef0f2;
    border-radius: 14px;
    padding: 8px 12px;
    font-size: 13px;
}
