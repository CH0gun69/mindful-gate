/* Light-mode counterpart to styles.qss -- same selectors/structure, just
   an inverted chrome palette (light background, dark text). Swapped in at
   runtime via the Phone Home Light/Dark control (see main.py's
   _on_theme_toggle_clicked) -- app.setStyleSheet() affects every screen
   immediately since both files share identical objectNames.

   Brand/accent colors (teal #93cfc4, the green Focus-Mode-active fill,
   each app's own icon color) are kept IDENTICAL to the dark file on
   purpose, for brand consistency -- only the neutral chrome (page/card
   backgrounds, borders, body/muted/dim text) inverts.

   Two deliberate exceptions, both documented inline below:
   1. The Fake App screen's feed/messages BODY content (the mocked
      Instagram/Facebook/X/Reddit/Messages UI) DOES get its own light
      variant here, following this same theme toggle -- but using generic
      "real app" light colors (white cards, near-black text, neutral
      grays), never mindful-gate's own teal/amber, so it still reads as
      "a real app" rather than adopting this app's own design system (see
      styles.qss's comment on that section for why it's kept separate at
      all). The "shorts" style (TikTok/YouTube) is the one part that
      intentionally stays unchanged regardless of theme -- its caption bar
      is a translucent dark overlay ON TOP OF a photo, which real
      apps/videos also keep dark for legibility regardless of the OS
      theme, so there's no separate "light" version of that specific
      overlay to make.
   2. ToggleSwitch and BreathingCircle (ui/widgets/toggle_switch.py,
      breathing_circle.py) are entirely self-painted in Python -- they
      never consult the app stylesheet at all, so this file cannot affect
      them either way. Confirmed via manual testing that their hardcoded
      colors (dark-gray "off" track, near-white thumb, translucent teal
      circle) still render with acceptable contrast against this light
      theme's backgrounds regardless -- not an oversight, just outside
      what a pure QSS swap can reach. */

QWidget {
    background-color: #f4f5f7;
    color: #14161a;
    font-family: "Segoe UI", "SF Pro Text", sans-serif;
}
QLabel#screenTitle {
    font-size: 24px;
    font-weight: 600;
}
QLabel#bigScreenTime {
    font-size: 44px;
    font-weight: 700;
    color: #93cfc4;
}
QLabel#caption {
    color: #6b7280;
    font-size: 13px;
}
QLabel#sectionLabel {
    font-size: 14px;
    font-weight: 600;
    color: #3a3f47;
    margin-top: 8px;
}
QFrame#statCard {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 12px;
}
QFrame#screenTimeCard {
    background-color: #ffffff;
    border-radius: 14px;
    padding: 18px;
}
QLabel#statValue {
    background: transparent;
    font-size: 20px;
    font-weight: 700;
}
QLabel#statLabel {
    background: transparent;
    color: #6b7280;
    font-size: 12px;
}
QFrame#appRow {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 8px;
}
QLabel#appName {
    background: transparent;
    font-weight: 500;
}
QLabel#badge {
    background: transparent;
    color: #93cfc4;
    font-size: 11px;
    margin-left: 8px;
}
QLabel#appTime {
    background: transparent;
    color: #6b7280;
}
QPushButton#primaryBtn {
    background-color: #93cfc4;
    color: #0e1012;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#primaryBtn:hover {
    background-color: #a7dad1;
}
/* Dashboard's Focus Mode button: idle reads as a neutral, waiting-to-be-
   clicked light gray (was dark gray in the dark theme -- same "neutral,
   not attention-grabbing" intent, just inverted so it doesn't read as an
   oddly-heavy dark button on an otherwise light page); active keeps the
   same calm green fill (self-contained, unaffected by page theme). */
QPushButton#focusBtnIdle {
    background-color: #e2e4e8;
    color: #14161a;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#focusBtnIdle:hover {
    background-color: #d7dade;
}
QPushButton#focusBtnActive {
    background-color: #3ebd5e;
    color: #0e1012;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#focusBtnActive:hover {
    background-color: #55c974;
}
QPushButton#secondaryBtn {
    background-color: transparent;
    color: #14161a;
    border: 1px solid #d7dade;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
}
QPushButton#linkBtn, QPushButton#simulateBtn {
    background-color: transparent;
    color: #6b7280;
    border: none;
    padding: 8px;
    font-size: 13px;
    text-decoration: underline;
}
QLabel#interruptTitle {
    font-size: 18px;
    color: #6b7280;
}
QLabel#interruptQuestion {
    font-size: 30px;
    font-weight: 700;
}
QLabel#intentionQuote {
    font-size: 16px;
    font-style: italic;
    color: #93cfc4;
    padding: 16px;
    background-color: #ffffff;
    border-radius: 10px;
}
QCheckBox {
    font-size: 14px;
    padding: 4px;
}
QLineEdit#intentionInput {
    background-color: #ffffff;
    border: 1px solid #d7dade;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
}
QPushButton#secondaryBtn:disabled {
    color: #9199a3;
    border-color: #e2e4e8;
}
QPushButton#reaffirmChip {
    background-color: transparent;
    border: 1px solid #93cfc4;
    color: #93cfc4;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 13px;
}
QPushButton#reaffirmChip:hover {
    background-color: rgba(147, 207, 196, 0.1);
}
QLabel#levelLabel {
    background: transparent;
    color: #3a3f47;
    font-size: 13px;
    font-weight: 600;
}
QSlider#levelSlider::groove:horizontal {
    height: 4px;
    background: #d7dade;
    border-radius: 2px;
}
QSlider#levelSlider::sub-page:horizontal {
    background: #93cfc4;
    border-radius: 2px;
}
QSlider#levelSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: #3a3f47;
    border-radius: 8px;
}
QLabel#timeSpentNote {
    color: #6b7280;
    font-size: 12px;
    background: transparent;
}
QLabel#fakeAppSubtitle {
    background-color: transparent;
    color: #6b7280;
    font-size: 11px;
}

/* ===== Phone Home Screen ===== */
QWidget#phoneHomeScreen {
    background-color: #f4f5f7;
}
QFrame#phoneStatusBar {
    background-color: #f4f5f7;
    border-bottom: 1px solid #e2e4e8;
}
QLabel#statusBarTime {
    background-color: transparent;
    color: #14161a;
    font-size: 15px;
    font-weight: 600;
}
QLabel#statusBarIcons {
    background-color: transparent;
    color: #6b7280;
    font-size: 12px;
}
QWidget#phoneHomeGrid {
    background-color: transparent;
}
QPushButton#appIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#appIcon:pressed {
    background-color: rgba(147, 207, 196, 0.15);
    border-radius: 12px;
}
QLabel#appIconLabel {
    background-color: transparent;
    color: #3a3f47;
    font-size: 11px;
}
QWidget#phoneHomeScreenTimeWrap {
    background-color: transparent;
}
/* Shuffle / Light-Dark / TH-EN referee controls, directly below the
   screen-time widget -- same card color as that widget, just compact. */
QPushButton#miniControlBtn {
    background-color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 10px 4px;
    font-size: 12px;
    color: #3a3f47;
}
QPushButton#miniControlBtn:pressed {
    background-color: #e5e7ea;
}
QPushButton#screenTimeWidget {
    background-color: #ffffff;
    border: none;
    border-radius: 14px;
    text-align: left;
}
QPushButton#screenTimeWidget:pressed {
    background-color: #e5e7ea;
}
QLabel#screenTimeValue {
    background: transparent;
    color: #93cfc4;
    font-size: 22px;
    font-weight: 700;
}
QLabel#screenTimeCaption {
    background: transparent;
    color: #6b7280;
    font-size: 12px;
}
QFrame#screenTimeDivider {
    background-color: #d7dade;
}
QLabel#screenTimeUnlocksValue {
    background: transparent;
    color: #14161a;
    font-size: 18px;
    font-weight: 700;
}
QLabel#screenTimeUnlocksCaption {
    background: transparent;
    color: #6b7280;
    font-size: 11px;
}
QFrame#phoneDock {
    background-color: #ffffff;
    border-radius: 20px;
}
QPushButton#dockIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QPushButton#dockIcon QLabel#appIconLabel {
    color: #6b7280;
    font-size: 10px;
}

/* ===== Fake App Screen =====
   Header bar flips to light chrome, same as everywhere else. The feed/
   messages BODY content below gets its own light "real app" variant too
   (see feed/messages sections below) -- only "shorts" stays unchanged
   regardless of theme, see this file's top comment. */
QWidget#fakeAppScreen {
    background-color: #f4f5f7;
}
QFrame#fakeAppHeader {
    background-color: #f4f5f7;
    border-bottom: 1px solid #e2e4e8;
}
QPushButton#fakeAppBackBtn {
    background-color: transparent;
    border: none;
    color: #14161a;
    font-size: 18px;
    padding: 4px 8px;
}
QPushButton#fakeAppBackBtn:pressed {
    color: #93cfc4;
}
QLabel#fakeAppTitle {
    background-color: transparent;
    color: #14161a;
    font-size: 17px;
    font-weight: 600;
}
/* --- feed style: Instagram / Facebook / X (Twitter) / Reddit ---
   A generic "real app" LIGHT look (white cards, near-black text, neutral
   grays) -- not mindful-gate's own teal/amber, just the light-mode
   sibling of the dark file's neutral/realistic palette. A thin border
   replaces the dark file's reliance on a darker-than-page card color,
   since a plain white card would otherwise blend into this theme's
   light page background. */
QFrame#feedPostCard {
    background-color: #ffffff;
    border: 1px solid #e2e2e4;
    border-radius: 10px;
}
QLabel#feedUsername {
    background-color: transparent;
    color: #1c1c1e;
    font-weight: 600;
    font-size: 13px;
}
QLabel#feedPhoto {
    background-color: #e8e8e8;
    border-radius: 0px;
}
QLabel#feedCaption {
    background-color: transparent;
    color: #3c3c3c;
    font-size: 12px;
}

/* Instagram/X action row: icon-only, evenly spaced */
QFrame#feedActionsIcons {
    background-color: transparent;
}
QPushButton#feedActionIcon {
    background-color: transparent;
    border: none;
    color: #1c1c1e;
    font-size: 20px;
    min-width: 34px; max-width: 34px;
    min-height: 34px; max-height: 34px;
    border-radius: 17px;
}
QPushButton#feedActionIconSmall {
    background-color: transparent;
    border: none;
    color: #5a5a5a;
    font-size: 15px;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    border-radius: 14px;
}

/* Facebook action row: full-width labeled buttons + thin dividers */
QFrame#feedActionsLabeled {
    background-color: transparent;
    border-top: 1px solid #e2e2e4;
}
QPushButton#feedActionLabeled {
    background-color: transparent;
    border: none;
    color: #4a4a4a;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 0px;
    border-radius: 8px;
}
QFrame#feedActionDivider {
    background-color: #e2e2e4;
    margin: 6px 0px;
}

/* Reddit vote cluster: vertical, left side of the card -- subtly shaded
   relative to the card, same relationship as the dark theme's slightly
   darker-than-card cluster bg. */
QFrame#voteCluster {
    background-color: #f2f2f3;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}
QPushButton#voteArrowUp, QPushButton#voteArrowDown {
    background-color: transparent;
    border: none;
    color: #6b6b6b;
    font-size: 13px;
    padding: 2px;
}
QLabel#voteCount {
    background-color: transparent;
    color: #1c1c1e;
    font-size: 11px;
    font-weight: 700;
}
QLabel#feedCommentCount {
    background-color: transparent;
    color: #6b6b6b;
    font-size: 11px;
}

/* Scrollable feed/messages content -- handle color left as the same
   mid-gray as the dark theme; it reads with reasonable contrast against
   either a dark feed body or this screen's light header, so it doesn't
   need its own light-mode variant. */
QScrollArea#feedScrollArea, QScrollArea#messagesChatScrollArea,
QScrollArea#protectionScrollArea {
    border: none;
}
QScrollArea#feedScrollArea QScrollBar:vertical,
QScrollArea#messagesChatScrollArea QScrollBar:vertical,
QScrollArea#protectionScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}
QScrollArea#feedScrollArea QScrollBar::handle:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::handle:vertical,
QScrollArea#protectionScrollArea QScrollBar::handle:vertical {
    background: #3a3f47;
    border-radius: 3px;
    min-height: 24px;
}
QScrollArea#feedScrollArea QScrollBar::add-line:vertical,
QScrollArea#feedScrollArea QScrollBar::sub-line:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::add-line:vertical,
QScrollArea#messagesChatScrollArea QScrollBar::sub-line:vertical,
QScrollArea#protectionScrollArea QScrollBar::add-line:vertical,
QScrollArea#protectionScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- shorts style: TikTok / YouTube --- unchanged, see exception 1 */
QFrame#shortsWrap {
    background-color: #000000;
}
QLabel#shortsImage {
    background-color: #000000;
}
QFrame#shortsCaptionBar {
    background-color: rgba(0, 0, 0, 0.55);
}
QLabel#shortsUsername {
    background-color: transparent;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
}
QLabel#shortsCaption {
    background-color: transparent;
    color: #e8e8e8;
    font-size: 12px;
}
QFrame#shortsIconsCol {
    background-color: transparent;
}
QLabel#shortsEngageIcon {
    background-color: transparent;
    color: #ffffff;
    font-size: 22px;
}
QLabel#shortsEngageCount {
    background-color: transparent;
    color: #d8d8d8;
    font-size: 10px;
    font-weight: 600;
}

/* --- messages style --- light "real app" look, same reasoning as feed
   above. chatBubbleMe keeps the same teal fill as the dark theme
   unchanged -- that's already self-contained (dark text on top,
   unaffected by page background) and plenty of real chat apps use one
   fixed accent for "me" bubbles regardless of light/dark, so it isn't
   "mindful-gate's palette leaking in", just the existing choice carried
   over as-is. */
QFrame#messagesSidebar {
    background-color: #f7f7f8;
    border-right: 1px solid #e2e2e4;
}
QWidget#messagesChatView {
    background-color: #ffffff;
}
QFrame#messagesContactRow {
    background-color: transparent;
    border-radius: 8px;
}
QFrame#messagesContactRowActive {
    background-color: #e8e9eb;
    border-radius: 8px;
}
QLabel#messagesContactName {
    background-color: transparent;
    color: #1c1c1e;
    font-size: 12px;
    font-weight: 600;
}
QLabel#messagesContactPreview {
    background-color: transparent;
    color: #6b6f76;
    font-size: 11px;
}
QLabel#chatBubbleMe {
    background-color: #93cfc4;
    color: #0e1012;
    border-radius: 14px;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#chatBubbleThem {
    background-color: #e5e6e8;
    color: #1c1c1e;
    border-radius: 14px;
    padding: 8px 12px;
    font-size: 13px;
}
